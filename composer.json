{
    "name": "wedeto/db",
    "license": "MIT",
    "description": "Wedeto Platform - Database Access Layer",
    "homepage": "https://wedeto.net/",
    "type": "library",
    "require": {
        "wedeto/util": "^1.1.1",
        "php": "^7.4 || >=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33",
        "phpspec/prophecy-phpunit": "^2.0"
    },
    "suggest": {
        "php-mysqli": "Allows connecting with MySQL databases",
        "php-pgsql": "Allow connecting with PostgreSQL databases"
    },
    "autoload": {
        "psr-4": {
            "Wedeto\\DB\\": "src/"
        }
    },
    "archive": {
        "exclude": ["/tests","/phpunit.xml"]
    },
    "authors": [
        {
            "name": "Egbert van der Wal",
            "email": "wedeto@pointpro.nl"
        }
    ]
}
